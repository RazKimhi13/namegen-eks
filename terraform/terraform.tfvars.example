# Copy to terraform.tfvars and fill in.
# Numeric GitHub IDs (required since GitHub's 2026-07-15 OIDC change):
#   curl -s https://api.github.com/repos/RazKimhi13/namegen-eks | jq '{owner_id: .owner.id, repo_id: .id}'

region          = "us-west-2"
cluster_name    = "namegen-cluster"
cluster_version = "1.31"

github_owner    = "RazKimhi13"
github_repo     = "namegen-eks"
github_owner_id = 111111111 # <- .owner.id
github_repo_id  = 222222222 # <- .id
github_branch   = "main"

# Set to false if the account already has the GitHub OIDC provider
# (it is account-global - only one can exist).
create_github_oidc_provider = true
